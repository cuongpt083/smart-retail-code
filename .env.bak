# ============================================================================
# Smart Retail Analytics - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_PATH=retail.db
DB_MAX_CONNECTIONS=2
DB_TIMEOUT=5
DB_WAL_MODE=true

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
# Cache backend: "memory" or "redis"
CACHE_BACKEND=memory

# Cache TTLs (in seconds)
CACHE_TTL_RFM=300           # 5 minutes
CACHE_TTL_APRIORI=600       # 10 minutes
CACHE_TTL_PRODUCTS=3600     # 1 hour
CACHE_TTL_CUSTOMERS=1800    # 30 minutes

# Redis configuration (if using redis backend)
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Requests per minute for each endpoint
RATE_LIMIT_KIOTVIET=100     # Kiotviet API
RATE_LIMIT_ZALO=50          # Zalo messaging
RATE_LIMIT_DASHBOARD=1000   # Dashboard requests

# ============================================================================
# CIRCUIT BREAKER CONFIGURATION
# ============================================================================
CIRCUIT_BREAKER_THRESHOLD=5        # Failures before opening
CIRCUIT_BREAKER_TIMEOUT=60         # Seconds before half-open

# ============================================================================
# EXTERNAL APIs
# ============================================================================
# Kiotviet API Configuration
# KIOTVIET_RETAIL_ID=your_retail_id_here
# KIOTVIET_API_KEY=your_api_key_here
KIOTVIET_ACCESS_TOKEN=
KIOTVIET_RETAILER_NAME=GSJ-Project-01 
KIOTVIET_CLIENT_ID=62baa6fd-4bc4-4731-bd8d-fdb2f53e9583
KIOTVIET_CLIENT_SECRET=D09025D78986AB98C3F54EA021FFE9E966E5C072
KIOTVIET_RETAIL_ID=62baa6fd-4bc4-4731-bd8d-fdb2f53e9583
KIOTVIET_API_KEY=D09025D78986AB98C3F54EA021FFE9E966E5C072

# Zalo OA Configuration
ZALO_ACCESS_TOKEN=your_zalo_oa_token_here

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json             # json or text
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760       # 10MB
LOG_BACKUP_COUNT=10         # Keep 10 rotated files

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_ZALO_CAMPAIGNS=true
FEATURE_CACHING=true
FEATURE_CIRCUIT_BREAKER=true
FEATURE_RATE_LIMITING=true

# ============================================================================
# SCHEDULER CONFIGURATION
# ============================================================================
SCHEDULER_INTERVAL_MINUTES=5    # Data refresh interval
SCHEDULER_ENABLED=true

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================
STREAMLIT_LOGGER_LEVEL=warning
STREAMLIT_CLIENT_TOOLBAR_MODE=viewer
